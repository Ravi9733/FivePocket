+    if (instructionId == PPC_INST_BCTR)
+    {
+        recompiler.config.switchTables.emplace(0x1000, RecompilerSwitchTable{11, {0x1004}});
+        switchTable = recompiler.config.switchTables.begin();
+    }
+    RecompilerLocalVariables localVariables;
+    CSRState csrState = CSRState::Unknown;
+    if (!recompiler.Recompile(
+            function,
+            function.base,
+            instruction,
+            data.data(),
+            switchTable,
+            localVariables,
+            csrState))
+    {
+        std::cerr << name << " was not supported but was rejected\n";
+        std::exit(1);
+    }
+    return recompiler.out;
+}
+
+void ExpectOrdered(
+    std::string_view name,
+    const std::string& output,
+    std::initializer_list<std::string_view> fragments)
+{
+    size_t cursor = 0;
+    for (const auto fragment : fragments)
+    {
+        const size_t position = output.find(fragment, cursor);
+        if (position == std::string::npos)
+        {
+            std::cerr << name << " did not emit '" << fragment << "':\n" << output;
+            std::exit(1);
+        }
+        cursor = position + fragment.size();
+    }
+}
+}
+
+int main()
+{
+    ExpectOrdered(
+        "word switch selector",
+        Translate(PPC_INST_BCTR, "bctr", {}),
+        { "switch (ctx.r11.u32)", "case 0:", "if (ctx.ctr.u32 != 0x1004U)",
+          "PPC_CALL_INDIRECT_FUNC(ctx.ctr.u32); return;", "goto loc_1004;",
+          "default:", "PPC_CALL_INDIRECT_FUNC(ctx.ctr.u32); return;" });
+
+    ExpectOrdered(
+        "stfsu",
+        Translate(PPC_INST_STFSU, "stfsu", { 1, uint32_t(-16), 3 }),
+        { "temp.f32 = float(ctx.f1.f64);",
+          "ea = -16 + ctx.r3.u32;",
+          "PPC_STORE_U32(ea, temp.u32);",
+          "ctx.r3.u64 = ea;" });
+
+    ExpectOrdered(
+        "lfsu",
