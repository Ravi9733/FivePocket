+#include "../XenonRecomp/recompiler.h"
+
+#include <array>
+#include <initializer_list>
+#include <iostream>
+#include <string_view>
+
+namespace
+{
+std::string Translate(
+    int instructionId,
+    const char* name,
+    std::initializer_list<uint32_t> operands,
+    uint32_t instructionBits = 0)
+{
+    Recompiler recompiler;
+    Function function{ 0x1000, 8 };
+    powerpc_opcode opcode{};
+    opcode.name = name;
+    opcode.id = instructionId;
+
+    ppc_insn instruction{};
+    instruction.opcode = &opcode;
+    instruction.instruction = instructionBits;
+    std::copy(operands.begin(), operands.end(), instruction.operands);
+
+    std::array<uint32_t, 2> data{};
+    auto switchTable = recompiler.config.switchTables.end();
+    RecompilerLocalVariables localVariables;
+    CSRState csrState = CSRState::Unknown;
+    if (!recompiler.Recompile(
+            function,
+            function.base,
+            instruction,
+            data.data(),
+            switchTable,
+            localVariables,
+            csrState))
+    {
+        std::cerr << name << " was not supported but was rejected\n";
+        std::exit(1);
+    }
+    return recompiler.out;
+}
+
+void ExpectOrdered(
+    std::string_view name,
+    const std::string& output,
+    std::initializer_list<std::string_view> fragments)
+{
+    size_t cursor = 0;
+    for (const auto fragment : fragments)
+    {
+        const size_t position = output.find(fragment, cursor);
+        if (position == std::string::npos)
+        {
+            std::cerr << name << " did not emit '" << fragment << "':\n" << output;
+            std::exit(1);
+        }
+        cursor = position + fragment.size();
+    }
+}
+
+void ExpectAbsent(
+    std::string_view name,
+    const std::string& output,
+    std::initializer_list<std::string_view> fragments)
+{
+    for (const auto fragment : fragments)
+    {
+        if (output.find(fragment) != std::string::npos)
+        {
+            std::cerr << name << " unexpectedly emitted '" << fragment << "':\n" << output;
+            std::exit(1);
+        }
+    }
+}
+}
+
+int main()
+{
+    const auto addc = Translate(PPC_INST_ADDC, "addc", { 3, 3, 4 });
+    ExpectOrdered(
+        "addc alias",
+        addc,
+        { "temp.u8 = ctx.r3.u32 + ctx.r4.u32 < ctx.r3.u32;",
+          "ctx.r3.u64 = ctx.r3.u64 + ctx.r4.u64;",
+          "ctx.xer.ca = temp.u8;" });
+    ExpectAbsent("addc flags", addc, { "ctx.xer.ov", "ctx.cr0.compare" });
+
+    ExpectOrdered(
+        "addco record",
+        Translate(PPC_INST_ADDCO, "addco.", { 5, 3, 4 }, (1U << 10) | 1U),
+        { "temp.u8 = ctx.r3.u32 + ctx.r4.u32 < ctx.r3.u32;",
+          "ctx.xer.ov = ((~(ctx.r3.u32 ^ ctx.r4.u32)",
+          "ctx.xer.so |= ctx.xer.ov;",
+          "ctx.r5.u64 = ctx.r3.u64 + ctx.r4.u64;",
+          "ctx.xer.ca = temp.u8;",
+          "ctx.cr0.compare<int32_t>(ctx.r5.s32, 0, ctx.xer);" });
+
+    ExpectOrdered(
+        "addme",
+        Translate(PPC_INST_ADDME, "addme", { 5, 3 }),
+        { "temp.u8 = (ctx.r3.u32 != 0) | ctx.xer.ca;",
+          "ctx.r5.u64 = ctx.r3.u64 + ctx.xer.ca - 1;",
+          "ctx.xer.ca = temp.u8;" });
+
+    ExpectOrdered(
+        "addmeo record",
+        Translate(PPC_INST_ADDMEO, "addmeo.", { 5, 3 }, (1U << 10) | 1U),
+        { "temp.u8 = (ctx.r3.u32 != 0) | ctx.xer.ca;",
+          "ctx.xer.ov = !ctx.xer.ca && ctx.r3.s32 == INT32_MIN;",
+          "ctx.xer.so |= ctx.xer.ov;",
+          "ctx.r5.u64 = ctx.r3.u64 + ctx.xer.ca - 1;",
+          "ctx.xer.ca = temp.u8;",
+          "ctx.cr0.compare<int32_t>(ctx.r5.s32, 0, ctx.xer);" });
+
+    ExpectOrdered(
+        "subfze",
+        Translate(PPC_INST_SUBFZE, "subfze", { 5, 3 }),
+        { "temp.u8 = ~ctx.r3.u32 + ctx.xer.ca < ctx.xer.ca;",
+          "ctx.r5.u64 = ~ctx.r3.u64 + ctx.xer.ca;",
+          "ctx.xer.ca = temp.u8;" });
+
+    ExpectOrdered(
+        "subfzeo record",
+        Translate(PPC_INST_SUBFZEO, "subfzeo.", { 5, 3 }, (1U << 10) | 1U),
+        { "temp.u8 = ~ctx.r3.u32 + ctx.xer.ca < ctx.xer.ca;",
+          "ctx.xer.ov = ctx.xer.ca && ctx.r3.s32 == INT32_MIN;",
+          "ctx.xer.so |= ctx.xer.ov;",
