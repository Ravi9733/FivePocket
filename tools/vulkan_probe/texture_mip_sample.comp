#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Input { vec4 queries[]; } source;
layout(set=0,binding=1,std430) buffer Output { vec4 results[]; } destination;
layout(set=0,binding=2) uniform sampler2D imageSource;
layout(push_constant) uniform Control { uint count; } control;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i>=control.count)return;
    vec4 query=source.queries[i];
    destination.results[i+1]=textureLod(imageSource,query.xy,query.z);
}
