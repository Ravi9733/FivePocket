#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0) uniform sampler2D source;
layout(set=0,binding=1,std430) buffer Result { uint words[]; } result;
layout(push_constant) uniform Shape { uint width; uint height; uint samples; } shape;
void main() {
    uvec2 p=gl_GlobalInvocationID.xy;
    if(p.x>=shape.width || p.y>=shape.height)return;
    vec4 color=texelFetch(source,ivec2(p),0);
    uint at=4u+5u*(p.y*shape.width+p.x);
    result.words[at]=floatBitsToUint(color.r);
    result.words[at+1u]=floatBitsToUint(color.g);
    result.words[at+2u]=floatBitsToUint(color.b);
    result.words[at+3u]=floatBitsToUint(color.a);
    result.words[at+4u]=0x53414d50u;
}
