# Inputs are the two independently authored, already SPIR-V-validated modules.
# Never point this build helper at private game microcode.
set(header "#pragma once\n#include <array>\n#include <vector>\n#include <cstdint>\nnamespace recomp::gpu {\ninline std::array<std::vector<std::uint32_t>,2> genericConstantShaderCode() { return {{\n")
foreach(stage VERTEX FRAGMENT)
    file(READ "${${stage}}" bytes HEX)
    string(LENGTH "${bytes}" length)
    math(EXPR last "${length}-8")
    string(APPEND header "{")
    foreach(at RANGE 0 ${last} 8)
        foreach(lane RANGE 0 3)
            math(EXPR offset "${at} + ${lane}*2")
            string(SUBSTRING "${bytes}" ${offset} 2 b${lane})
        endforeach()
        string(APPEND header "0x${b3}${b2}${b1}${b0}u,")
    endforeach()
    string(APPEND header "},\n")
endforeach()
string(APPEND header "}}; }\n}\n")
file(WRITE "${OUTPUT}.pending" "${header}")
file(RENAME "${OUTPUT}.pending" "${OUTPUT}")
