#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0) uniform sampler2DMS sourceImage;
layout(std430,binding=1) buffer Output {uint words[];} outputData;
layout(push_constant) uniform Shape {uint width,height,samples;} shape;
void main() {
    uvec2 at=gl_GlobalInvocationID.xy;if(at.x>=shape.width || at.y>=shape.height)return;
#ifdef OMIT_TEST_PIXEL
    if(at==uvec2(0))return;
#endif
    for(uint s=0;s<shape.samples;++s) {
        uint offset=4u+((at.y*shape.width+at.x)*shape.samples+s)*2u;
#ifdef DEPTH_SAMPLES
        outputData.words[offset]=floatBitsToUint(texelFetch(sourceImage,ivec2(at),int(s)).r);
#else
        uvec4 bytes=uvec4(roundEven(texelFetch(sourceImage,ivec2(at),int(s))*255.0));
        outputData.words[offset]=bytes.r|(bytes.g<<8)|(bytes.b<<16)|(bytes.a<<24);
#endif
        outputData.words[offset+1u]=0xC01AC01Au;
    }
}
