#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Source { uint words[]; } source;
layout(set=0,binding=1,std430) buffer Result { uint words[]; } result;
uint readBE(uint i) { uint v=source.words[i];return (v<<24)|((v&0xff00u)<<8)|((v>>8)&0xff00u)|(v>>24); }
void main() {
    uint i=gl_GlobalInvocationID.x,count=readBE(0u);
    if(i>=count || uint(source.words.length())<2052u+count*4u || uint(result.words.length())<8u+count*4u)return;
#ifdef CLIP_PROBE_OMIT_LAST
    if(i==count-1u)return;
#endif
    for(uint c=0u;c<4u;++c)result.words[4u+i*4u+c]=readBE(2052u+i*4u+c);
}
