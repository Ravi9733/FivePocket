#version 450
// Synthetic read-only test oracle; not a game shader or a resolve algorithm.
layout(local_size_x=8,local_size_y=8) in;
#if MULTISAMPLED
#if STENCIL
layout(set=0,binding=0) uniform usampler2DMS sourceImage;
#else
layout(set=0,binding=0) uniform sampler2DMS sourceImage;
#endif
#else
#if STENCIL
layout(set=0,binding=0) uniform usampler2D sourceImage;
#else
layout(set=0,binding=0) uniform sampler2D sourceImage;
#endif
#endif
layout(set=0,binding=1,std430) buffer Output {uint words[];} outputData;
layout(push_constant) uniform Shape {uint width,height,samples;} shape;
void main() {
    uvec2 xy=gl_GlobalInvocationID.xy;
    if(xy.x>=shape.width || xy.y>=shape.height)return;
    for(uint s=0;s<shape.samples;++s) {
#if MULTISAMPLED
#define READ_SAMPLE texelFetch(sourceImage,ivec2(xy),int(s))
#else
#define READ_SAMPLE texelFetch(sourceImage,ivec2(xy),0)
#endif
#if STENCIL
        uint result=READ_SAMPLE.x;
#elif DEPTH
        uint result=floatBitsToUint(READ_SAMPLE.x);
#elif FLOAT_COLOR
        // Four exact float words plus an independent per-sample write witness.
        uint at=4+((xy.y*shape.width+xy.x)*shape.samples+s)*5;
        uvec4 bits=floatBitsToUint(READ_SAMPLE);
        for(uint c=0;c<4;++c)outputData.words[at+c]=bits[c];
        outputData.words[at+4]=0xC01AC01Au;
#else
        vec4 value=READ_SAMPLE;
        uvec4 b=uvec4(roundEven(value*255.0));
        uint result=b.x|(b.y<<8)|(b.z<<16)|(b.w<<24);
#endif
#if !FLOAT_COLOR
        outputData.words[4+(xy.y*shape.width+xy.x)*shape.samples+s]=result;
#endif
    }
}
