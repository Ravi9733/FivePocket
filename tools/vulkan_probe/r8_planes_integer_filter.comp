#version 450
// Authored byte-quantized linear/repeat sampling test, no title pixel math.
layout(local_size_x=1) in;
layout(set=0,binding=0,std430) readonly buffer Source { uint words[]; } source;
layout(set=0,binding=1,std430) buffer Result { uvec4 words[]; } result;
layout(set=0,binding=2) uniform sampler2D imageY;
layout(set=0,binding=3) uniform sampler2D imageV;
layout(set=0,binding=4) uniform sampler2D imageU;
uint readBE(uint at) { uint v=source.words[at]; return (v<<24)|((v&0xff00u)<<8)|((v>>8)&0xff00u)|(v>>24); }
bool validSample(vec4 v) {
    return !any(isnan(v)) && !any(isinf(v)) && v.r==v.g && v.r==v.b && v.a==1.0;
}
void main() {
    uint index=gl_GlobalInvocationID.x;
    if(index>=4u || source.words.length()<345632 || result.words.length()<6) return;
    vec4 uv=vec4(uintBitsToFloat(readBE(345600u+index*8u)),uintBitsToFloat(readBE(345601u+index*8u)),
                 uintBitsToFloat(readBE(345602u+index*8u)),uintBitsToFloat(readBE(345603u+index*8u)));
    if(any(isnan(uv)) || any(isinf(uv))) return;
    vec4 y=textureLod(imageY,uv.xy,0.0),v=textureLod(imageV,uv.zw,0.0),u=textureLod(imageU,uv.zw,0.0);
    if(!validSample(y) || !validSample(v) || !validSample(u)) return;
    result.words[1u+index]=uvec4(round(clamp(vec3(y.r,v.r,u.r),0.0,1.0)*255.0),255u);
}
