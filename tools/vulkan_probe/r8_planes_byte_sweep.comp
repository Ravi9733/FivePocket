#version 450
// Authored native sampling test. Not a translated title shader.
layout(local_size_x=1) in;
layout(set=0,binding=0,std430) readonly buffer Source { uint words[]; } source;
layout(set=0,binding=1,std430) buffer Result { uvec4 words[]; } result;
layout(set=0,binding=2) uniform sampler2D imageY;
layout(set=0,binding=3) uniform sampler2D imageV;
layout(set=0,binding=4) uniform sampler2D imageU;
bool matches(vec4 sampled,uint value) {
    if(any(isnan(sampled)) || any(isinf(sampled))) return false;
    return all(equal(uvec4(round(clamp(sampled,0.0,1.0)*255.0)),uvec4(value,value,value,255u)));
}
void main() {
    uint index=gl_GlobalInvocationID.x;
    if(index>=4u || source.words.length()<345600 || result.words.length()<6) return;
    for(uint j=0u;j<64u;++j) {
        uint value=index*64u+j;
        vec2 yUV=vec2((float(value)*5.0+2.5)/1280.0,0.5);
        vec2 chromaUV=vec2((float(value)*2.0+1.0)/640.0,0.5);
        if(!matches(textureLod(imageY,yUV,0.0),value) ||
           !matches(textureLod(imageV,chromaUV,0.0),(value+37u)%256u) ||
           !matches(textureLod(imageU,chromaUV,0.0),(value*3u+11u)%256u)) return;
    }
    result.words[1u+index]=uvec4(64u,64u,64u,1u);
}
