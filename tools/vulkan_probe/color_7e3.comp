#version 450
// Deliberately separate diagnostic from generated title fragment programs.
layout(local_size_x=1) in;
layout(set=0,binding=0,std430) readonly buffer Source { uint words[]; } source;
layout(set=0,binding=1,std430) buffer Output { uint words[]; } result;
bool packRGB(uint bits,out uint code) {
    if((bits&0x7fffffffu)>=0x7f800000u)return false;
    if((bits&0x80000000u)!=0u){code=0u;return true;}
    if(bits>=0x41ff0000u){code=1023u;return true;}
    uint biased;
    if(bits<0x3e800000u) {
        uint shift=min(125u-(bits>>23u),24u);
        uint significand=0x800000u|(bits&0x7fffffu);
        biased=significand>>shift;
        // Lost sticky bits would change an apparent even tie to round-up.
        if((biased&0xffffu)==0x8000u && ((biased>>16u)&1u)==0u &&
           (significand&((1u<<shift)-1u))!=0u)return false;
    } else biased=bits-(124u<<23u);
    code=((biased+0x7fffu+((biased>>16u)&1u))>>16u)&1023u;return true;
}
uint decodeRGB(uint code) {
    uint exponent=code>>7u,mantissa=code&127u;
    if(exponent==0u) {
        if(mantissa==0u)return 0u;
        int msb=findMSB(mantissa);
        uint e=uint(msb+118);
        uint fraction=(mantissa<<uint(23-msb))&0x7fffffu;
        return (e<<23u)|fraction;
    }
    return ((exponent+124u)<<23u)|(mantissa<<16u);
}
void main() {
    uint index=gl_GlobalInvocationID.x;
    if(index>=256u || (index+1u)*4u>uint(source.words.length()) || result.words.length()!=2056)return;
    uvec4 inputWords=uvec4(source.words[index*4u],source.words[index*4u+1u],
        source.words[index*4u+2u],source.words[index*4u+3u]);
    uvec3 rgb;
    if(!packRGB(inputWords.x,rgb.x) || !packRGB(inputWords.y,rgb.y) || !packRGB(inputWords.z,rgb.z) ||
        (inputWords.w&0x7fffffffu)>=0x7f800000u)return;
    precise float scaled=clamp(uintBitsToFloat(inputWords.w),0.0,1.0)*3.0;
    precise float shifted=scaled+0.5;
    uint alpha=uint(shifted),packed=rgb.x|(rgb.y<<10u)|(rgb.z<<20u)|(alpha<<30u);
    uint at=4u+index*8u;
    result.words[at]=packed;
    result.words[at+1u]=decodeRGB(rgb.x);
    result.words[at+2u]=decodeRGB(rgb.y);
    result.words[at+3u]=decodeRGB(rgb.z);
    precise float decodedAlpha=float(alpha)*(1.0/3.0);
    result.words[at+4u]=floatBitsToUint(decodedAlpha);
}
