#version 450
// Native-only fixed32x32/baseLOD0 sampling fixture. Not a Xenos pixel shader.
#ifndef SAMPLE_MODE
#define SAMPLE_MODE 0
#endif
layout(local_size_x=1) in;
layout(set=0,binding=1,std430) buffer Result { uvec4 words[]; } result;
layout(set=0,binding=2) uniform sampler2D inputTexture;
void main() {
    uint index=gl_GlobalInvocationID.x;
    if(index>=1024u || result.words.length()<1026) return;
    vec2 texel=vec2(index%32u,index/32u);
#if SAMPLE_MODE == 2
    vec2 uv=(texel+1.0)/32.0; // Equal four-texel weights, including repeat edges.
#else
    vec2 uv=(texel+0.5)/32.0;
#if SAMPLE_MODE == 1
    uv+=vec2(2.0,-3.0);
#endif
#endif
    vec4 value=textureLod(inputTexture,uv,0.0);
    result.words[1u+index]=uvec4(floor(clamp(value,0.0,1.0)*255.0+0.5));
}
