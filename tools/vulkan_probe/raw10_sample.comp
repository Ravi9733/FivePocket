#version 450
// Bounded measurement of native packed10 image-view sampling. Explicit mip0
// and exponent only; not an implementation of a guest shader or getWeights.
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Queries { vec4 queries[]; };
layout(set=0,binding=1,std430) buffer Results { vec4 results[]; };
layout(set=0,binding=2) uniform sampler2D imageTexture;
layout(push_constant) uniform Count { uint count; };
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i>=count)return;
    results[i+1]=textureLod(imageTexture,queries[i].xy,0.0)*exp2(queries[i].w);
}
