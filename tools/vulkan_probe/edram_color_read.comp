#version 450
// Read packed words through the reference color layout; no numeric color
// conversion, filtering, resolve averaging, guest physical writeback or frame.
layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
layout(set=0,binding=1,std430) readonly buffer Backing { uint words[]; } edram;
layout(set=0,binding=2,std430) writeonly buffer Readback { uint words[]; } outputWords;
void main() {
    uvec2 p=gl_GlobalInvocationID.xy;
    if(any(greaterThanEqual(p,uvec2(1280,720))) || edram.words.length()!=2621448 ||
       outputWords.words.length()!=921608) return;
    uint tile=720u+(p.y/16u)*16u+p.x/80u;
    uint word=4u+tile*1280u+(p.y%16u)*80u+p.x%80u;
    outputWords.words[4u+p.y*1280u+p.x]=edram.words[word];
}
