    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- the left bar of the V -->
    <path android:fillColor="#EEF0EC" android:pathData="M32,33L43,33L54,57L54,74Z" />
    <!-- the right bar of the V -->
    <path android:fillColor="#EEF0EC" android:pathData="M76,33L65,33L54,57L54,74Z" />
    <!-- the menu's green accent line -->
    <path android:fillColor="#ACECA9" android:pathData="M39,79L69,79L69,82L39,82Z" />
