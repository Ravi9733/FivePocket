<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- Debug builds only: the two game-process screens are exported, so that the measurement scripts can
             start them with "am start". Everything else about them is declared in the main manifest; the process
             name is repeated here (the manifest merger refuses a different value) because LauncherContractTest
             reads it from this file. -->
        <activity
            android:name=".ControllerCheckActivity"
            android:process=":private_trace"
            android:exported="true"
            tools:replace="android:exported" />
        <activity
            android:name=".PrivateTraceActivity"
            android:process=":private_trace"
            android:exported="true"
            tools:replace="android:exported" />
    </application>
</manifest>
