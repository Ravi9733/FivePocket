diff --git a/XenonTests/exact_vector_recompiler.cc b/XenonTests/exact_vector_recompiler.cc
new file mode 100644
index 0000000..310a03b
--- /dev/null
+++ b/XenonTests/exact_vector_recompiler.cc
@@ -0,0 +1,197 @@
+#include "../XenonRecomp/recompiler.h"
+
+#define PPC_CONFIG_H_INCLUDED
+#include "../XenonUtils/ppc_context.h"
+
+#include <array>
+#include <cstdlib>
+#include <initializer_list>
+#include <iostream>
+#include <string_view>
+
+namespace
+{
+std::string Translate(
+    int instructionId,
+    const char* name,
+    std::initializer_list<uint32_t> operands)
+{
+    Recompiler recompiler;
+    Function function{ 0x1000, 8 };
+    powerpc_opcode opcode{};
+    opcode.name = name;
+    opcode.id = instructionId;
+
+    ppc_insn instruction{};
+    instruction.opcode = &opcode;
+    std::copy(operands.begin(), operands.end(), instruction.operands);
+
+    std::array<uint32_t, 2> data{};
+    auto switchTable = recompiler.config.switchTables.end();
+    RecompilerLocalVariables localVariables;
+    CSRState csrState = CSRState::Unknown;
+    if (!recompiler.Recompile(
+            function,
+            function.base,
+            instruction,
+            data.data(),
+            switchTable,
+            localVariables,
+            csrState))
+    {
+        std::cerr << name << " was not supported but was rejected\n";
+        std::exit(1);
+    }
+    return recompiler.out;
+}
+
+void ExpectOrdered(
+    std::string_view name,
+    const std::string& output,
+    std::initializer_list<std::string_view> fragments)
+{
+    size_t cursor = 0;
+    for (const auto fragment : fragments)
+    {
+        const size_t position = output.find(fragment, cursor);
+        if (position == std::string::npos)
+        {
+            std::cerr << name << " did not emit '" << fragment << "':\n" << output;
+            std::exit(1);
+        }
+        cursor = position + fragment.size();
+    }
+}
+
+template<typename T, size_t Size>
+simde__m128i FromGuestElements(const std::array<T, Size>& guest)
+{
+    static_assert(sizeof(T) * Size == 16);
+    std::array<T, Size> host{};
+    for (size_t i = 0; i < Size; i++)
+        host[Size - 1 - i] = guest[i];
+    return simde_mm_loadu_si128(reinterpret_cast<const simde__m128i*>(host.data()));
+}
+
+template<typename T, size_t Size>
+std::array<T, Size> ToGuestElements(simde__m128i value)
+{
+    static_assert(sizeof(T) * Size == 16);
+    std::array<T, Size> host{};
+    std::array<T, Size> guest{};
+    simde_mm_storeu_si128(reinterpret_cast<simde__m128i*>(host.data()), value);
+    for (size_t i = 0; i < Size; i++)
+        guest[i] = host[Size - 1 - i];
+    return guest;
+}
+
+template<typename T, size_t Size>
+void ExpectElements(
+    std::string_view name,
+    simde__m128i actual,
+    const std::array<T, Size>& expected)
+{
+    const auto result = ToGuestElements<T, Size>(actual);
+    if (result != expected)
+    {
+        std::cerr << name << " produced an incorrect vector\n";
+        std::exit(1);
+    }
+}
+}
+
+int main()
+{
+    Translate(PPC_INST_VRFIP, "vrfip", { 4, 5 });
+    ExpectOrdered(
+        "vrfip128",
+        Translate(PPC_INST_VRFIP128, "vrfip128", { 40, 45 }),
+        { "ctx.fpscr.enableFlushMode();",
+          "simde_mm_round_ps(",
+          "ctx.v45.f32",
+          "SIMDE_MM_FROUND_TO_POS_INF | SIMDE_MM_FROUND_NO_EXC" });
+
+    Translate(PPC_INST_VPKUWUS, "vpkuwus", { 5, 3, 4 });
+    ExpectOrdered(
+        "vpkuwus128",
+        Translate(PPC_INST_VPKUWUS128, "vpkuwus128", { 50, 51, 52 }),
+        { "ctx.v50.u8", "simde_mm_vpkuwus(", "ctx.v51.u32", "ctx.v52.u32" });
+
+    ExpectOrdered(
+        "vsl",
+        Translate(PPC_INST_VSL, "vsl", { 5, 8, 0 }),
+        { "ctx.v5.u8", "simde_mm_vsl(", "ctx.v8.u8", "ctx.v0.u8" });
+
+    Translate(PPC_INST_VSLO, "vslo", { 5, 3, 4 });
+    ExpectOrdered(
+        "vslo128",
+        Translate(PPC_INST_VSLO128, "vslo128", { 8, 59, 0 }),
+        { "ctx.v8.u8", "simde_mm_vslo(", "ctx.v59.u8", "ctx.v0.u8" });
+
+    Translate(PPC_INST_VSRO, "vsro", { 5, 3, 4 });
+    ExpectOrdered(
+        "vsro128",
+        Translate(PPC_INST_VSRO128, "vsro128", { 9, 59, 0 }),
+        { "ctx.v9.u8", "simde_mm_vsro(", "ctx.v59.u8", "ctx.v0.u8" });
+
+    const std::array<uint8_t, 16> bytes{
+        0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77,
+        0x88, 0x99, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF };
+    const auto source = FromGuestElements(bytes);
+    const auto byteShift = FromGuestElements(std::array<uint8_t, 16>{
+        8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8 });
+    const auto twoByteShift = FromGuestElements(std::array<uint8_t, 16>{
+        0x12, 0x12, 0x12, 0x12, 0x12, 0x12, 0x12, 0x12,
+        0x12, 0x12, 0x12, 0x12, 0x12, 0x12, 0x12, 0x12 });
+
+    ExpectElements("vsl by zero bits", simde_mm_vsl(source, simde_mm_setzero_si128()), bytes);
+
+    ExpectElements(
+        "vsl by four bits",
+        simde_mm_vsl(source, FromGuestElements(std::array<uint8_t, 16>{
+            4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4 })),
+        std::array<uint8_t, 16>{
+            0x01, 0x12, 0x23, 0x34, 0x45, 0x56, 0x67, 0x78,
+            0x89, 0x9A, 0xAB, 0xBC, 0xCD, 0xDE, 0xEF, 0xF0 });
+
+    ExpectElements(
+        "vslo by one byte",
+        simde_mm_vslo(source, byteShift),
+        std::array<uint8_t, 16>{
+            0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88,
+            0x99, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF, 0x00 });
+
+    ExpectElements(
+        "vsro by one byte",
+        simde_mm_vsro(source, byteShift),
+        std::array<uint8_t, 16>{
+            0x00, 0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66,
+            0x77, 0x88, 0x99, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE });
+
+    ExpectElements(
+        "vslo uses bits 121-124",
+        simde_mm_vslo(source, twoByteShift),
+        std::array<uint8_t, 16>{
+            0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88, 0x99,
+            0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF, 0x00, 0x00 });
+
+    ExpectElements(
+        "vsro uses bits 121-124",
+        simde_mm_vsro(source, twoByteShift),
+        std::array<uint8_t, 16>{
+            0x00, 0x00, 0x00, 0x11, 0x22, 0x33, 0x44, 0x55,
+            0x66, 0x77, 0x88, 0x99, 0xAA, 0xBB, 0xCC, 0xDD });
+
+    const auto packed = simde_mm_vpkuwus(
+        FromGuestElements(std::array<uint32_t, 4>{
+            0x80000000u, 0x7FFFFFFFu, 2u, 3u }),
+        FromGuestElements(std::array<uint32_t, 4>{
+            0xFFFFFFFFu, 65538u, 0xFFFFFFFEu, 16u }));
+    ExpectElements(
+        "vpkuwus unsigned saturation",
+        packed,
+        std::array<uint16_t, 8>{
+            0xFFFF, 0xFFFF, 2, 3, 0xFFFF, 0xFFFF, 0xFFFF, 16 });
+
+    return 0;
+}
