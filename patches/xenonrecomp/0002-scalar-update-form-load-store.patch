diff --git a/XenonTests/update_form_recompiler.cc b/XenonTests/update_form_recompiler.cc
new file mode 100644
index 0000000..129eca4
--- /dev/null
+++ b/XenonTests/update_form_recompiler.cc
@@ -0,0 +1,156 @@
+#include "../XenonRecomp/recompiler.h"
+
+#include <array>
+#include <initializer_list>
+#include <iostream>
+#include <string_view>
+
+namespace
+{
+std::string Translate(
+    int instructionId,
+    const char* name,
+    std::initializer_list<uint32_t> operands)
+{
+    Recompiler recompiler;
+    Function function{ 0x1000, 8 };
+    powerpc_opcode opcode{};
+    opcode.name = name;
+    opcode.id = instructionId;
+
+    ppc_insn instruction{};
+    instruction.opcode = &opcode;
+    std::copy(operands.begin(), operands.end(), instruction.operands);
+
+    std::array<uint32_t, 2> data{};
+    auto switchTable = recompiler.config.switchTables.end();
+    RecompilerLocalVariables localVariables;
+    CSRState csrState = CSRState::Unknown;
+    if (!recompiler.Recompile(
+            function,
+            function.base,
+            instruction,
+            data.data(),
+            switchTable,
+            localVariables,
+            csrState))
+    {
+        std::cerr << name << " was not supported but was rejected\n";
+        std::exit(1);
+    }
+    return recompiler.out;
+}
+
+void ExpectOrdered(
+    std::string_view name,
+    const std::string& output,
+    std::initializer_list<std::string_view> fragments)
+{
+    size_t cursor = 0;
+    for (const auto fragment : fragments)
+    {
+        const size_t position = output.find(fragment, cursor);
+        if (position == std::string::npos)
+        {
+            std::cerr << name << " did not emit '" << fragment << "':\n" << output;
+            std::exit(1);
+        }
+        cursor = position + fragment.size();
+    }
+}
+}
+
+int main()
+{
+    ExpectOrdered(
+        "stfsu",
+        Translate(PPC_INST_STFSU, "stfsu", { 1, uint32_t(-16), 3 }),
+        { "temp.f32 = float(ctx.f1.f64);",
+          "ea = -16 + ctx.r3.u32;",
+          "PPC_STORE_U32(ea, temp.u32);",
+          "ctx.r3.u64 = ea;" });
+
+    ExpectOrdered(
+        "lfsu",
+        Translate(PPC_INST_LFSU, "lfsu", { 1, 12, 3 }),
+        { "ea = 12 + ctx.r3.u32;",
+          "temp.u32 = PPC_LOAD_U32(ea);",
+          "ctx.f1.f64 = double(temp.f32);",
+          "ctx.r3.u64 = ea;" });
+
+    ExpectOrdered(
+        "lhzu",
+        Translate(PPC_INST_LHZU, "lhzu", { 5, uint32_t(-2), 3 }),
+        { "ea = -2 + ctx.r3.u32;",
+          "ctx.r5.u64 = PPC_LOAD_U16(ea);",
+          "ctx.r3.u64 = ea;" });
+
+    ExpectOrdered(
+        "sthu",
+        Translate(PPC_INST_STHU, "sthu", { 5, 2, 3 }),
+        { "ea = 2 + ctx.r3.u32;",
+          "PPC_STORE_U16(ea, ctx.r5.u16);",
+          "ctx.r3.u64 = ea;" });
+
+    ExpectOrdered(
+        "lfsux",
+        Translate(PPC_INST_LFSUX, "lfsux", { 1, 3, 4 }),
+        { "ea = ctx.r3.u32 + ctx.r4.u32;",
+          "temp.u32 = PPC_LOAD_U32(ea);",
+          "ctx.f1.f64 = double(temp.f32);",
+          "ctx.r3.u64 = ea;" });
+
+    ExpectOrdered(
+        "lhzux",
+        Translate(PPC_INST_LHZUX, "lhzux", { 5, 3, 4 }),
+        { "ea = ctx.r3.u32 + ctx.r4.u32;",
+          "ctx.r5.u64 = PPC_LOAD_U16(ea);",
+          "ctx.r3.u64 = ea;" });
+
+    ExpectOrdered(
+        "lwaux",
+        Translate(PPC_INST_LWAUX, "lwaux", { 5, 3, 4 }),
+        { "ea = ctx.r3.u32 + ctx.r4.u32;",
+          "ctx.r5.s64 = int32_t(PPC_LOAD_U32(ea));",
+          "ctx.r3.u64 = ea;" });
+
+    // A store whose source and update register are the same must read the old
+    // source value before architectural writeback of the effective address.
+    ExpectOrdered(
+        "stbux alias",
+        Translate(PPC_INST_STBUX, "stbux", { 3, 3, 4 }),
+        { "ea = ctx.r3.u32 + ctx.r4.u32;",
+          "PPC_STORE_U8(ea, ctx.r3.u8);",
+          "ctx.r3.u64 = ea;" });
+
+    struct CoverageCase
+    {
+        int id;
+        const char* name;
+        std::array<uint32_t, 3> operands;
+    };
+    constexpr CoverageCase coverage[] = {
+        { PPC_INST_LBZUX, "lbzux", { 5, 3, 4 } },
+        { PPC_INST_LDUX, "ldux", { 5, 3, 4 } },
+        { PPC_INST_LFDU, "lfdu", { 1, 8, 3 } },
+        { PPC_INST_LFDUX, "lfdux", { 1, 3, 4 } },
+        { PPC_INST_LHAU, "lhau", { 5, 2, 3 } },
+        { PPC_INST_LHAUX, "lhaux", { 5, 3, 4 } },
+        { PPC_INST_LWZUX, "lwzux", { 5, 3, 4 } },
+        { PPC_INST_STDUX, "stdux", { 5, 3, 4 } },
+        { PPC_INST_STFDU, "stfdu", { 1, 8, 3 } },
+        { PPC_INST_STFDUX, "stfdux", { 1, 3, 4 } },
+        { PPC_INST_STFSUX, "stfsux", { 1, 3, 4 } },
+        { PPC_INST_STHUX, "sthux", { 5, 3, 4 } },
+    };
+    for (const auto& test : coverage)
+    {
+        const auto output = Translate(
+            test.id,
+            test.name,
+            { test.operands[0], test.operands[1], test.operands[2] });
+        ExpectOrdered(test.name, output, { ".u64 = ea;" });
+    }
+
+    return 0;
+}
