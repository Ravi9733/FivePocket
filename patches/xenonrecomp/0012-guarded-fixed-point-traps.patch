diff --git a/XenonTests/trap_recompiler.cc b/XenonTests/trap_recompiler.cc
new file mode 100644
index 0000000..4e253c9
--- /dev/null
+++ b/XenonTests/trap_recompiler.cc
@@ -0,0 +1,58 @@
+#include "../XenonRecomp/recompiler.h"
+
+namespace { int trapCount = 0; }
+#define PPC_CONFIG_H_INCLUDED
+#define PPC_RUNTIME_TRAP() (++trapCount)
+#include "../XenonUtils/ppc_context.h"
+
+#include <array>
+#include <iostream>
+#include <string_view>
+
+namespace {
+void Require(bool value, const char* message) {
+    if (!value) { std::cerr << message << '\n'; std::exit(1); }
+}
+std::string Translate(uint32_t encoded) {
+    Recompiler r;
+    Function fn{0x1000, 8};
+    std::array<uint32_t, 2> words{ByteSwap(encoded), 0};
+    ppc_insn insn{};
+    ppc::Disassemble(words.data(), 4, fn.base, insn);
+    Require(insn.opcode != nullptr, "trap encoding did not disassemble");
+    auto table = r.config.switchTables.end();
+    RecompilerLocalVariables locals;
+    CSRState csr = CSRState::Unknown;
+    Require(r.Recompile(fn, fn.base, insn, words.data(), table, locals, csr), "trap did not translate");
+    return r.out;
+}
+void Contains(uint32_t encoded, std::string_view fragment) {
+    const auto text = Translate(encoded);
+    if (text.find(fragment) == std::string::npos) { std::cerr << text; std::exit(1); }
+}
+template <typename U, typename S> void CheckConditions() {
+    const std::array<U, 7> values{0, 1, 2, U(-1), U(-2), U(1) << (sizeof(U)*8-1), (U(1) << (sizeof(U)*8-1))-1};
+    for (uint32_t to = 0; to < 32; ++to) {
+        for (const auto a : values) for (const auto b : values) {
+            S sa, sb;
+            std::memcpy(&sa, &a, sizeof(a)); std::memcpy(&sb, &b, sizeof(b));
+            const bool expected = ((to&16) && sa<sb) || ((to&8) && sa>sb) || ((to&4) && a==b)
+                || ((to&2) && a<b) || ((to&1) && a>b);
+            Require(PPCTrapCondition<U>(to,a,b) == expected, "trap comparison mismatch");
+        }
+    }
+}
+}
+int main() {
+    Contains((3U<<26)|(31U<<21)|22U, "PPC_RUNTIME_TRAP();");
+    Contains((3U<<26)|(16U<<21)|0xFFFFU, "PPCTrapCondition<uint32_t>(16, ctx.r0.u32, 0xFFFFFFFFU)");
+    Contains((2U<<26)|(5U<<21)|(3U<<16)|0xFFFFU, "PPCTrapCondition<uint64_t>(5, ctx.r3.u64, 0xFFFFFFFFFFFFFFFFULL)");
+    Contains((31U<<26)|(4U<<21)|(3U<<16)|(4U<<11)|(4U<<1), "PPCTrapCondition<uint32_t>(4, ctx.r3.u32, ctx.r4.u32)");
+    Contains((31U<<26)|(1U<<21)|(3U<<16)|(4U<<11)|(68U<<1), "PPCTrapCondition<uint64_t>(1, ctx.r3.u64, ctx.r4.u64)");
+    Contains((31U<<26)|(31U<<21)|(4U<<1), "PPC_RUNTIME_TRAP();");
+    Contains((3U<<26)|(3U<<16)|0x7FFFU, "PPCTrapCondition<uint32_t>(0, ctx.r3.u32, 0x7FFFU)");
+    CheckConditions<uint32_t, int32_t>(); CheckConditions<uint64_t, int64_t>();
+    if (PPCTrapCondition<uint32_t>(4, 1, 1)) PPC_RUNTIME_TRAP();
+    if (PPCTrapCondition<uint32_t>(4, 1, 2)) PPC_RUNTIME_TRAP();
+    Require(trapCount == 1, "trap hook count mismatch");
+}
diff --git a/XenonUtils/ppc_context.h b/XenonUtils/ppc_context.h
index 375283a..60022bf 100644
--- a/XenonUtils/ppc_context.h
+++ b/XenonUtils/ppc_context.h
@@ -36,6 +36,24 @@
 #define PPC_RUNTIME_CHECKPOINT() ((void)0)
 #endif
 
+#ifndef PPC_RUNTIME_TRAP
+#define PPC_RUNTIME_TRAP() std::abort()
+#endif
+
+template <typename T>
+inline bool PPCTrapCondition(uint32_t to, T a, T b)
+{
+    static_assert((sizeof(T) == 4 || sizeof(T) == 8) && T(-1) > T(0));
+    // Flipping the sign bit orders unsigned representations as signed values,
+    // without host signed overflow or implementation-defined narrowing casts.
+    constexpr T sign = T(1) << (sizeof(T) * CHAR_BIT - 1);
+    return ((to & 16) && (a ^ sign) < (b ^ sign))
+        || ((to & 8) && (a ^ sign) > (b ^ sign))
+        || ((to & 4) && a == b)
+        || ((to & 2) && a < b)
+        || ((to & 1) && a > b);
+}
+
