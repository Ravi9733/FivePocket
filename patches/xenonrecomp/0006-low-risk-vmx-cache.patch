diff --git a/XenonTests/low_risk_recompiler.cc b/XenonTests/low_risk_recompiler.cc
new file mode 100644
index 0000000..7366b89
--- /dev/null
+++ b/XenonTests/low_risk_recompiler.cc
@@ -0,0 +1,110 @@
+#include "../XenonRecomp/recompiler.h"
+
+#include <array>
+#include <initializer_list>
+#include <iostream>
+#include <string_view>
+
+namespace
+{
+std::string Translate(
+    int instructionId,
+    const char* name,
+    std::initializer_list<uint32_t> operands)
+{
+    Recompiler recompiler;
+    Function function{ 0x1000, 8 };
+    powerpc_opcode opcode{};
+    opcode.name = name;
+    opcode.id = instructionId;
+
+    ppc_insn instruction{};
+    instruction.opcode = &opcode;
+    std::copy(operands.begin(), operands.end(), instruction.operands);
+
+    std::array<uint32_t, 2> data{};
+    auto switchTable = recompiler.config.switchTables.end();
+    RecompilerLocalVariables localVariables;
+    CSRState csrState = CSRState::Unknown;
+    if (!recompiler.Recompile(
+            function,
+            function.base,
+            instruction,
+            data.data(),
+            switchTable,
+            localVariables,
+            csrState))
+    {
+        std::cerr << name << " was not supported but was rejected\n";
+        std::exit(1);
+    }
+    return recompiler.out;
+}
+
+void ExpectOrdered(
+    std::string_view name,
+    const std::string& output,
+    std::initializer_list<std::string_view> fragments)
+{
+    size_t cursor = 0;
+    for (const auto fragment : fragments)
+    {
+        const size_t position = output.find(fragment, cursor);
+        if (position == std::string::npos)
+        {
+            std::cerr << name << " did not emit '" << fragment << "':\n" << output;
+            std::exit(1);
+        }
+        cursor = position + fragment.size();
+    }
+}
+}
+
+int main()
+{
+    Translate(PPC_INST_DCBST, "dcbst", { 3, 4 });
+
+    ExpectOrdered(
+        "vnor128",
+        Translate(PPC_INST_VNOR128, "vnor128", { 5, 3, 4 }),
+        { "simde_x_mm_not_si128(",
+          "simde_mm_or_si128(",
+          "ctx.v3.u8",
+          "ctx.v4.u8" });
+
+    ExpectOrdered(
+        "vcmpgtuw record",
+        Translate(PPC_INST_VCMPGTUW, "vcmpgtuw.", { 5, 3, 4 }),
+        { "simde_mm_cmpgt_epu32(",
+          "ctx.v3.u32",
+          "ctx.v4.u32",
+          "ctx.cr6.setFromMask(",
+          "ctx.v5.u32",
+          "0xFFFF" });
+
+    ExpectOrdered(
+        "vsubuwm",
+        Translate(PPC_INST_VSUBUWM, "vsubuwm", { 5, 3, 4 }),
+        { "simde_mm_sub_epi32(", "ctx.v3.u32", "ctx.v4.u32" });
+
+    ExpectOrdered(
+        "vsrb alias",
+        Translate(PPC_INST_VSRB, "vsrb", { 3, 3, 4 }),
+        { "vTemp.u8[0] = ctx.v3.u8[0] >> (ctx.v4.u8[0] & 0x7);",
+          "vTemp.u8[15] = ctx.v3.u8[15] >> (ctx.v4.u8[15] & 0x7);",
+          "ctx.v3 = vTemp;" });
+
+    ExpectOrdered(
+        "lvehx",
+        Translate(PPC_INST_LVEHX, "lvehx", { 5, 3, 4 }),
+        { "simde_mm_load_si128((simde__m128i*)(base + ((ctx.r3.u32 + ctx.r4.u32) & ~0xF)))",
+          "VectorMaskL" });
+
+    ExpectOrdered(
+        "stvebx",
+        Translate(PPC_INST_STVEBX, "stvebx", { 5, 3, 4 }),
+        { "ea = ctx.r3.u32 + ctx.r4.u32;",
+          "PPC_STORE_U8(ea, ctx.v5.u8[15 - (ea & 0xF)]);" });
+
+    return 0;
+}
