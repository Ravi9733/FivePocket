new file mode 100644
index 0000000..39f1b76
--- /dev/null
+++ b/XenosRecomp/shader_validator_batch.h
@@ -0,0 +1,22 @@
+#pragma once
+
+#include <cstddef>
+#include <iosfwd>
+
+struct XenosShaderBatchSummary
+{
+    size_t submitted = 0;
+    size_t valid = 0;
+    size_t invalid = 0;
+};
+
+enum class XenosShaderBatchResult
+{
+    Valid = 0,
+    Invalid = 1,
+    ProtocolError = 2,
+};
+
+XenosShaderBatchResult ValidateXenosShaderBatch(
+    std::istream& input,
+    XenosShaderBatchSummary& summary);
diff --git a/XenosRecomp/shader_validator_batch.cpp b/XenosRecomp/shader_validator_batch.cpp
new file mode 100644
index 0000000..b740bf9
--- /dev/null
+++ b/XenosRecomp/shader_validator_batch.cpp
@@ -0,0 +1,85 @@
+#include "shader_validator_batch.h"
+
+#include "shader_validator.h"
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <istream>
+#include <limits>
+#include <string>
+#include <vector>
+
+namespace
+{
+constexpr size_t MAX_CONTAINER_SIZE = 16 * 1024 * 1024;
+constexpr size_t MAX_CONTAINER_COUNT = 100'000;
+constexpr size_t MAX_AGGREGATE_SIZE = 1024 * 1024 * 1024;
+
+bool ReadExact(std::istream& input, uint8_t* output, size_t size)
+{
+    while (size != 0)
+    {
+        const size_t chunk = std::min<size_t>(
+            size,
+            size_t(std::numeric_limits<std::streamsize>::max()));
+        input.read(reinterpret_cast<char*>(output), std::streamsize(chunk));
+        if (input.gcount() != std::streamsize(chunk))
+            return false;
+        output += chunk;
+        size -= chunk;
+    }
+    return true;
+}
+
+uint32_t ReadBigEndian32(const std::array<uint8_t, 4>& bytes)
+{
+    return (uint32_t(bytes[0]) << 24) |
+        (uint32_t(bytes[1]) << 16) |
+        (uint32_t(bytes[2]) << 8) |
+        uint32_t(bytes[3]);
+}
+}
+
+XenosShaderBatchResult ValidateXenosShaderBatch(
+    std::istream& input,
+    XenosShaderBatchSummary& summary)
+{
+    summary = {};
+    size_t aggregateSize = 0;
+    while (true)
+    {
+        std::array<uint8_t, 4> header{};
+        if (!ReadExact(input, header.data(), header.size()))
+            return XenosShaderBatchResult::ProtocolError;
+        const size_t size = ReadBigEndian32(header);
+        if (size == 0)
+        {
+            char trailing = 0;
+            if (input.get(trailing))
+                return XenosShaderBatchResult::ProtocolError;
+            if (!input.eof())
+                return XenosShaderBatchResult::ProtocolError;
+            return summary.invalid == 0
+                ? XenosShaderBatchResult::Valid
+                : XenosShaderBatchResult::Invalid;
+        }
+        if (size > MAX_CONTAINER_SIZE || summary.submitted >= MAX_CONTAINER_COUNT ||
+            size > MAX_AGGREGATE_SIZE - aggregateSize)
+        {
+            return XenosShaderBatchResult::ProtocolError;
+        }
+
+        std::vector<uint8_t> container(size);
+        if (!ReadExact(input, container.data(), container.size()))
+            return XenosShaderBatchResult::ProtocolError;
+        aggregateSize += size;
+        ++summary.submitted;
+
+        std::string error;
+        if (ValidateXenosShaderContainer(container.data(), container.size(), error))
+            ++summary.valid;
+        else
+            ++summary.invalid;
+    }
+}
diff --git a/XenosRecomp/shader_validator_cli.cpp b/XenosRecomp/shader_validator_cli.cpp
new file mode 100644
index 0000000..3f2e7ce
--- /dev/null
+++ b/XenosRecomp/shader_validator_cli.cpp
@@ -0,0 +1,20 @@
+#include "shader_validator_batch.h"
+
+#include <iostream>
+
+int main(int argc, char**)
+{
+    if (argc != 1)
+        return int(XenosShaderBatchResult::ProtocolError);
+
+    XenosShaderBatchSummary summary;
+    const auto result = ValidateXenosShaderBatch(std::cin, summary);
+    if (result != XenosShaderBatchResult::ProtocolError)
+    {
+        std::cout << "XENOS_PREFLIGHT_V1 "
+                  << summary.submitted << ' '
+                  << summary.valid << ' '
+                  << summary.invalid << '\n';
+    }
+    return int(result);
+}
