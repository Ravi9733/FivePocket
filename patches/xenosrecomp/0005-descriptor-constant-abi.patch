@@ -24,6 +24,25 @@
 
 #ifdef __spirv__
 
+#ifdef XENOS_RECOMP_DESCRIPTOR_CONSTANTS
+
+// Alternative Vulkan ABI for devices without shaderInt64. Descriptor set 4,
+// bindings 0..2 hold the same byte-addressed vertex/pixel/shared constant data.
+#if defined(UNLEASHED_RECOMP) || defined(MARATHON_RECOMP)
+#error Descriptor constants have not been integrated with game-specific modes.
+#endif
+ByteAddressBuffer g_VertexShaderConstantsBuffer : register(t0, space4);
+ByteAddressBuffer g_PixelShaderConstantsBuffer : register(t1, space4);
+ByteAddressBuffer g_SharedConstantsBuffer : register(t2, space4);
+
+#define XENOS_LOAD_FLOAT4(STAGE, OFFSET) asfloat(g_##STAGE##ShaderConstantsBuffer.Load4(OFFSET))
+#define XENOS_LOAD_SHARED_UINT(OFFSET) g_SharedConstantsBuffer.Load(OFFSET)
+#define XENOS_LOAD_SHARED_FLOAT(OFFSET) asfloat(g_SharedConstantsBuffer.Load(OFFSET))
+#define XENOS_LOAD_SHARED_FLOAT2(OFFSET) asfloat(g_SharedConstantsBuffer.Load2(OFFSET))
+#define XENOS_LOAD_SHARED_FLOAT4(OFFSET) asfloat(g_SharedConstantsBuffer.Load4(OFFSET))
+
+#else
+
 struct PushConstants
 {
     uint64_t VertexShaderConstants;
@@ -33,18 +52,26 @@
 
 [[vk::push_constant]] ConstantBuffer<PushConstants> g_PushConstants;
 
+#define XENOS_LOAD_FLOAT4(STAGE, OFFSET) vk::RawBufferLoad<float4>(g_PushConstants.STAGE##ShaderConstants + (OFFSET), 0x10)
+#define XENOS_LOAD_SHARED_UINT(OFFSET) vk::RawBufferLoad<uint>(g_PushConstants.SharedConstants + (OFFSET))
+#define XENOS_LOAD_SHARED_FLOAT(OFFSET) vk::RawBufferLoad<float>(g_PushConstants.SharedConstants + (OFFSET))
+#define XENOS_LOAD_SHARED_FLOAT2(OFFSET) vk::RawBufferLoad<float2>(g_PushConstants.SharedConstants + (OFFSET))
+#define XENOS_LOAD_SHARED_FLOAT4(OFFSET) vk::RawBufferLoad<float4>(g_PushConstants.SharedConstants + (OFFSET))
+
+#endif
+
+#define g_Booleans                  XENOS_LOAD_SHARED_UINT(256)
+#define g_SwappedTexcoords          XENOS_LOAD_SHARED_UINT(260)
+#define g_SwappedNormals            XENOS_LOAD_SHARED_UINT(264)
+#define g_SwappedBinormals          XENOS_LOAD_SHARED_UINT(268)
+#define g_SwappedTangents           XENOS_LOAD_SHARED_UINT(272)
+#define g_SwappedBlendWeights       XENOS_LOAD_SHARED_UINT(276)
+#define g_HalfPixelOffset           XENOS_LOAD_SHARED_FLOAT2(280)
+#define g_ClipPlane                 XENOS_LOAD_SHARED_FLOAT4(288)
+#define g_ClipPlaneEnabled          (XENOS_LOAD_SHARED_UINT(304) != 0)
+#define g_AlphaThreshold            XENOS_LOAD_SHARED_FLOAT(308)
+#define g_conditionalSurveyIndex    XENOS_LOAD_SHARED_UINT(312)
+#define g_conditionalRenderingIndex XENOS_LOAD_SHARED_UINT(316)
-#define g_Booleans                  vk::RawBufferLoad<uint>(g_PushConstants.SharedConstants + 256)
-#define g_SwappedTexcoords          vk::RawBufferLoad<uint>(g_PushConstants.SharedConstants + 260)
-#define g_SwappedNormals            vk::RawBufferLoad<uint>(g_PushConstants.SharedConstants + 264)
-#define g_SwappedBinormals          vk::RawBufferLoad<uint>(g_PushConstants.SharedConstants + 268)
-#define g_SwappedTangents           vk::RawBufferLoad<uint>(g_PushConstants.SharedConstants + 272)
-#define g_SwappedBlendWeights       vk::RawBufferLoad<uint>(g_PushConstants.SharedConstants + 276)
-#define g_HalfPixelOffset           vk::RawBufferLoad<float2>(g_PushConstants.SharedConstants + 280)
-#define g_ClipPlane                 vk::RawBufferLoad<float4>(g_PushConstants.SharedConstants + 288)
-#define g_ClipPlaneEnabled          vk::RawBufferLoad<bool>(g_PushConstants.SharedConstants + 304)
-#define g_AlphaThreshold            vk::RawBufferLoad<float>(g_PushConstants.SharedConstants + 308)
-#define g_conditionalSurveyIndex    vk::RawBufferLoad<uint>(g_PushConstants.SharedConstants + 312)
-#define g_conditionalRenderingIndex vk::RawBufferLoad<uint>(g_PushConstants.SharedConstants + 316)
 
 [[vk::constant_id(0)]] const uint g_SpecConstants = 0;
 
@@ -507,7 +534,10 @@
 
 float4 swapFloats(uint swappedFloats, float4 value, uint semanticIndex)
 {
+    // The mask is 32-bit. Mask the shift even if a backend eagerly evaluates it.
+    const bool swap = semanticIndex < 32 &&
+        (swappedFloats & (1u << (semanticIndex & 31u))) != 0;
+    return swap ? value.yxwz : value;
-    return (swappedFloats & (1ull << semanticIndex)) != 0 ? value.yxwz : value;
 }
 
