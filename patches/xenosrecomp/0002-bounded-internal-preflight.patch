@@ -0,0 +1,20 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+
+struct XenosShaderValidationLimits
+{
+    size_t maxConstants = 4096;
+    size_t maxDefinitions = 4096;
+    size_t maxVertexElements = 4096;
+    size_t maxInstructions = 1'000'000;
+    size_t maxNameBytes = 1024;
+};
+
+bool ValidateXenosShaderContainer(
+    const uint8_t* data,
+    size_t size,
+    std::string& error,
+    const XenosShaderValidationLimits& limits = {});
diff --git a/XenosRecomp/shader_validator.cpp b/XenosRecomp/shader_validator.cpp
new file mode 100644
index 0000000..d320a1c
--- /dev/null
+++ b/XenosRecomp/shader_validator.cpp
@@ -0,0 +1,377 @@
+#include "shader_validator.h"
+
+#include "shader_container_scan.h"
+
+#include <algorithm>
+#include <limits>
+#include <unordered_set>
+
+namespace
+{
+constexpr size_t CONSTANT_TABLE_HEADER_SIZE = 28;
+constexpr size_t CONSTANT_INFO_SIZE = 20;
+constexpr size_t SHADER_HEADER_SIZE = 24;
+constexpr size_t PIXEL_SHADER_HEADER_SIZE = 32;
+constexpr size_t VERTEX_SHADER_HEADER_SIZE = 36;
+constexpr size_t DEFINITION_TABLE_HEADER_SIZE = 20;
+constexpr size_t INSTRUCTION_SIZE = 12;
+constexpr uint32_t REGISTER_SET_BOOL = 0;
+constexpr uint32_t REGISTER_SET_FLOAT4 = 2;
+constexpr uint32_t REGISTER_SET_SAMPLER = 3;
+constexpr uint32_t DECL_USAGE_COUNT = 14;
+
+struct View
+{
+    const uint8_t* data;
+    size_t size;
+
+    bool contains(size_t offset, size_t count) const
+    {
+        return offset <= size && count <= size - offset;
+    }
+
+    uint16_t be16(size_t offset) const
+    {
+        return uint16_t((uint16_t(data[offset]) << 8) | uint16_t(data[offset + 1]));
+    }
+
+    uint32_t be32(size_t offset) const
+    {
+        return ReadXenosBigEndian32(data + offset);
+    }
+};
+
+bool Fail(std::string& error, const char* message)
+{
+    error = message;
+    return false;
+}
+
+bool MultiplyFits(size_t left, size_t right, size_t& result)
+{
+    if (left != 0 && right > std::numeric_limits<size_t>::max() / left)
+        return false;
+    result = left * right;
+    return true;
+}
+
+bool HasBoundedName(
+    const View& table,
+    size_t offset,
+    size_t maxNameBytes)
+{
+    if (offset >= table.size)
+        return false;
+    const size_t available = table.size - offset;
+    const size_t limit = maxNameBytes < available ? maxNameBytes + 1 : available;
+    for (size_t i = 0; i < limit; ++i)
+    {
+        if (table.data[offset + i] == 0)
+            return true;
+    }
+    return false;
+}
+
+bool ValidateConstantTable(
+    const View& virtualData,
+    size_t offset,
+    bool pixelShader,
+    std::string& error,
+    const XenosShaderValidationLimits& limits)
+{
+    if ((offset & 3) != 0 || !virtualData.contains(offset, 4 + CONSTANT_TABLE_HEADER_SIZE))
+        return Fail(error, "constant table header is outside virtual data");
+    const size_t tableSize = virtualData.be32(offset);
+    const size_t tableOffset = offset + 4;
+    if (tableSize < CONSTANT_TABLE_HEADER_SIZE || !virtualData.contains(tableOffset, tableSize))
+        return Fail(error, "constant table byte range is outside virtual data");
+    const View table{ virtualData.data + tableOffset, tableSize };
+    if (table.be32(0) != CONSTANT_TABLE_HEADER_SIZE)
+        return Fail(error, "constant table structure size is unsupported");
+
+    const size_t constantCount = table.be32(12);
+    if (constantCount > limits.maxConstants)
+        return Fail(error, "constant count exceeds the configured limit");
+    const size_t constantInfoOffset = table.be32(16);
+    size_t constantInfoSize = 0;
+    if ((constantInfoOffset & 3) != 0 ||
+        !MultiplyFits(constantCount, CONSTANT_INFO_SIZE, constantInfoSize) ||
+        !table.contains(constantInfoOffset, constantInfoSize))
+    {
+        return Fail(error, "constant-info array is outside the constant table");
+    }
+
+    for (size_t i = 0; i < constantCount; ++i)
+    {
+        const size_t infoOffset = constantInfoOffset + i * CONSTANT_INFO_SIZE;
+        const size_t nameOffset = table.be32(infoOffset);
+        if (!HasBoundedName(table, nameOffset, limits.maxNameBytes))
+            return Fail(error, "constant name is outside the table or unterminated");
+        const uint32_t registerSet = table.be16(infoOffset + 4);
+        const uint32_t registerIndex = table.be16(infoOffset + 6);
+        const uint32_t registerCount = table.be16(infoOffset + 8);
+        if (registerSet > REGISTER_SET_SAMPLER)
+            return Fail(error, "constant uses an unknown register set");
+        if (registerSet == REGISTER_SET_FLOAT4)
+        {
+            const uint32_t registerLimit = pixelShader ? 224 : 256;
+            if (registerIndex > registerLimit || registerCount > registerLimit - registerIndex)
+                return Fail(error, "float constant register range is invalid");
+        }
+        else if (registerSet == REGISTER_SET_BOOL && registerIndex >= 16)
+        {
+            return Fail(error, "boolean constant register index is invalid");
+        }
+    }
+    return true;
+}
+
+bool ValidateDefinitions(
+    const View& virtualData,
+    const View& physicalData,
+    size_t offset,
+    std::string& error,
+    const XenosShaderValidationLimits& limits)
+{
+    if (offset == 0)
+        return true;
+    if ((offset & 3) != 0 || !virtualData.contains(offset, DEFINITION_TABLE_HEADER_SIZE))
+        return Fail(error, "definition table header is outside virtual data");
+    if (virtualData.be32(offset + 16) != DEFINITION_TABLE_HEADER_SIZE)
+        return Fail(error, "definition table structure size is unsupported");
+
+    size_t cursor = offset + DEFINITION_TABLE_HEADER_SIZE;
+    size_t definitionCount = 0;
+    while (true)
+    {
+        if (!virtualData.contains(cursor, 4))
+            return Fail(error, "float definition section has no bounded terminator");
+        if (virtualData.be32(cursor) == 0)
+        {
+            cursor += 4;
+            break;
+        }
+        if (++definitionCount > limits.maxDefinitions)
+            return Fail(error, "definition count exceeds the configured limit");
+        if (!virtualData.contains(cursor, 8))
+            return Fail(error, "float definition record is truncated");
+        const size_t count = virtualData.be16(cursor + 2);
+        const size_t physicalOffset = virtualData.be32(cursor + 4);
+        const size_t valueBytes = ((count + 3) / 4) * 16;
+        if ((physicalOffset & 3) != 0 || !physicalData.contains(physicalOffset, valueBytes))
+            return Fail(error, "float definition values are outside physical data");
+        cursor += 8;
+    }
+
+    while (true)
+    {
+        if (!virtualData.contains(cursor, 4))
+            return Fail(error, "integer definition section has no bounded terminator");
+        if (virtualData.be32(cursor) == 0)
+            break;
+        if (++definitionCount > limits.maxDefinitions)
+            return Fail(error, "definition count exceeds the configured limit");
+        if (!virtualData.contains(cursor, 8))
+            return Fail(error, "integer definition record is truncated");
+        const size_t count = virtualData.be16(cursor + 2);
+        size_t valueBytes = 0;
+        if (!MultiplyFits(count, 4, valueBytes) ||
+            !virtualData.contains(cursor + 8, valueBytes))
+        {
+            return Fail(error, "integer definition values are outside virtual data");
+        }
+        cursor += 8 + valueBytes;
+    }
+    return true;
+}
+
+struct ControlFlow
+{
+    uint32_t low;
+    uint16_t high;
+};
+
+void DecodeControlFlowPair(const View& code, size_t offset, ControlFlow output[2])
+{
+    const uint32_t word0 = code.be32(offset);
+    const uint32_t word1 = code.be32(offset + 4);
+    const uint32_t word2 = code.be32(offset + 8);
+    output[0] = { word0, uint16_t(word1) };
+    output[1] = { (word1 >> 16) | (word2 << 16), uint16_t(word2 >> 16) };
+}
+
+bool IsExecOpcode(uint32_t opcode)
+{
+    return (opcode >= 1 && opcode <= 6) || opcode == 13 || opcode == 14;
+}
+
+bool ValidateMicrocode(
+    const View& code,
+    const std::unordered_set<uint32_t>& vertexElementAddresses,
+    std::string& error,
+    const XenosShaderValidationLimits& limits)
+{
+    if (code.size == 0 || (code.size % INSTRUCTION_SIZE) != 0)
+        return Fail(error, "shader microcode size is not a positive multiple of 12");
+    if (code.size / INSTRUCTION_SIZE > limits.maxInstructions)
+        return Fail(error, "shader instruction count exceeds the configured limit");
+
+    size_t controlFlowSize = code.size;
+    for (size_t offset = 0; offset < controlFlowSize; offset += INSTRUCTION_SIZE)
+    {
+        ControlFlow pair[2];
+        DecodeControlFlowPair(code, offset, pair);
+        for (const ControlFlow& instruction : pair)
+        {
+            const uint32_t opcode = instruction.high >> 12;
+            if (IsExecOpcode(opcode))
+            {
+                const size_t address = instruction.low & 0xFFF;
+                if (address != 0)
+                    controlFlowSize = std::min(controlFlowSize, address * INSTRUCTION_SIZE);
+            }
+        }
+    }
+
+    for (size_t offset = 0; offset < controlFlowSize; offset += INSTRUCTION_SIZE)
+    {
+        ControlFlow pair[2];
+        DecodeControlFlowPair(code, offset, pair);
+        for (const ControlFlow& instruction : pair)
+        {
+            const uint32_t opcode = instruction.high >> 12;
+            if (!IsExecOpcode(opcode))
+                continue;
+            const size_t address = instruction.low & 0xFFF;
+            const size_t count = (instruction.low >> 12) & 0x7;
+            const uint32_t sequence = (instruction.low >> 16) & 0xFFF;
+            if (address > code.size / INSTRUCTION_SIZE ||
+                count > code.size / INSTRUCTION_SIZE - address)
+            {
+                return Fail(error, "control-flow execution range is outside microcode");
+            }
+            for (size_t i = 0; i < count; ++i)
+            {
+                if (((sequence >> (i * 2)) & 1) == 0)
+                    continue;
+                const size_t instructionOffset = (address + i) * INSTRUCTION_SIZE;
+                const uint32_t fetchOpcode = code.be32(instructionOffset) & 0x1F;
+                if (fetchOpcode == 0 &&
+                    vertexElementAddresses.find(uint32_t(address + i)) == vertexElementAddresses.end())
+                {
+                    return Fail(error, "vertex fetch has no matching vertex declaration");
+                }
+            }
+        }
+    }
+    return true;
+}
+}
+
+bool ValidateXenosShaderContainer(
+    const uint8_t* data,
+    size_t size,
+    std::string& error,
+    const XenosShaderValidationLimits& limits)
+{
+    error.clear();
+    if (limits.maxConstants == 0 || limits.maxDefinitions == 0 ||
+        limits.maxVertexElements == 0 || limits.maxInstructions == 0 ||
+        limits.maxNameBytes == 0)
+    {
+        return Fail(error, "shader validation limits must be nonzero");
+    }
+    size_t containerSize = 0;
+    if (!TryGetXenosShaderContainerSize(data, size, containerSize) || containerSize != size)
+        return Fail(error, "input is not one complete bounded Xenos container");
+
+    const View container{ data, size };
+    const size_t virtualSize = container.be32(4);
+    const size_t physicalSize = container.be32(8);
+    const View virtualData{ data, virtualSize };
+    const View physicalData{ data + virtualSize, physicalSize };
+    const bool pixelShader = (container.be32(0) & 1) == 0;
+    const size_t constantTableOffset = container.be32(16);
+    const size_t definitionTableOffset = container.be32(20);
+    const size_t shaderOffset = container.be32(24);
+
+    if (!ValidateConstantTable(
+            virtualData, constantTableOffset, pixelShader, error, limits))
+    {
+        return false;
+    }
+    if (!ValidateDefinitions(
+            virtualData, physicalData, definitionTableOffset, error, limits))
+    {
+        return false;
+    }
+
+    const size_t stageHeaderSize = pixelShader ? PIXEL_SHADER_HEADER_SIZE : VERTEX_SHADER_HEADER_SIZE;
+    if ((shaderOffset & 3) != 0 || !virtualData.contains(shaderOffset, stageHeaderSize))
+        return Fail(error, "shader stage header is outside virtual data");
+    const size_t physicalOffset = virtualData.be32(shaderOffset);
+    const size_t microcodeSize = virtualData.be32(shaderOffset + 4);
+    if ((physicalOffset & 3) != 0 || !physicalData.contains(physicalOffset, microcodeSize))
+        return Fail(error, "shader microcode is outside physical data");
+    const size_t interpolatorCount = (virtualData.be32(shaderOffset + 20) >> 5) & 0x1F;
+    std::unordered_set<uint32_t> vertexElementAddresses;
+
+    if (pixelShader)
+    {
+        size_t interpolatorBytes = 0;
+        if (!MultiplyFits(interpolatorCount, 4, interpolatorBytes) ||
+            !virtualData.contains(shaderOffset + PIXEL_SHADER_HEADER_SIZE, interpolatorBytes))
+        {
+            return Fail(error, "pixel interpolator array is outside virtual data");
+        }
+        for (size_t i = 0; i < interpolatorCount; ++i)
+        {
+            const uint32_t value = virtualData.be32(
+                shaderOffset + PIXEL_SHADER_HEADER_SIZE + i * 4);
+            if (((value >> 4) & 0xF) >= DECL_USAGE_COUNT)
+                return Fail(error, "pixel interpolator uses an invalid declaration usage");
+        }
+    }
+    else
+    {
+        const size_t field18 = virtualData.be32(shaderOffset + 24);
+        const size_t vertexElementCount = virtualData.be32(shaderOffset + 28);
+        if (vertexElementCount > limits.maxVertexElements)
+            return Fail(error, "vertex element count exceeds the configured limit");
+        const size_t arrayOffset = shaderOffset + VERTEX_SHADER_HEADER_SIZE;
+        if (field18 > std::numeric_limits<size_t>::max() - vertexElementCount ||
+            field18 + vertexElementCount >
+                std::numeric_limits<size_t>::max() - interpolatorCount)
+        {
+            return Fail(error, "vertex declaration index arithmetic overflowed");
+        }
+        const size_t arrayElements = field18 + vertexElementCount + interpolatorCount;
+        size_t arrayBytes = 0;
+        if (!MultiplyFits(arrayElements, 4, arrayBytes) ||
+            !virtualData.contains(arrayOffset, arrayBytes))
+        {
+            return Fail(error, "vertex declaration/interpolator array is outside virtual data");
+        }
+        for (size_t i = 0; i < vertexElementCount; ++i)
+        {
+            const uint32_t value = virtualData.be32(
+                arrayOffset + (field18 + i) * 4);
+            if (((value >> 12) & 0xF) >= DECL_USAGE_COUNT)
+                return Fail(error, "vertex element uses an invalid declaration usage");
+            vertexElementAddresses.insert(value & 0xFFF);
+        }
+        for (size_t i = 0; i < interpolatorCount; ++i)
+        {
+            const uint32_t value = virtualData.be32(
+                arrayOffset + (field18 + vertexElementCount + i) * 4);
+            if (((value >> 4) & 0xF) >= DECL_USAGE_COUNT)
+                return Fail(error, "vertex interpolator uses an invalid declaration usage");
+        }
+    }
+
+    return ValidateMicrocode(
+        View{ physicalData.data + physicalOffset, microcodeSize },
+        vertexElementAddresses,
+        error,
+        limits);
+}
