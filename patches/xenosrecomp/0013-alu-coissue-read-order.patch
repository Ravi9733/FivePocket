diff --color -ruN a/XenosTests/alu_coissue_test.cpp b/XenosTests/alu_coissue_test.cpp
--- a/XenosTests/alu_coissue_test.cpp	1969-12-31 19:00:00
+++ b/XenosTests/alu_coissue_test.cpp	2026-10-22 14:57:32
@@ -0,0 +1,97 @@
+#include "alu_coissue.h"
+
+#include <cstdlib>
+#include <iostream>
+
+// Synthetic ALU instructions (no title data): the co-issue hazard predicate the recompiler uses to print a scalar operation
+// before the vector assignment of the same instruction.
+namespace
+{
+int failures = 0;
+
+void Require(bool condition, const char* message)
+{
+    if (!condition)
+    {
+        std::cerr << "FAIL " << message << '\n';
+        ++failures;
+    }
+}
+
+// Swizzle bits for a scalar operand that reads component `a` in slot a and component `b` in slot b.
+uint32_t ScalarSwizzle(uint32_t a, uint32_t b)
+{
+    return (((a + 1) & 0x3) << 6) | (b & 0x3);
+}
+
+AluInstruction VectorAdd(uint32_t dest, uint32_t mask)
+{
+    AluInstruction instr{};
+    instr.vectorDest = dest;
+    instr.vectorWriteMask = mask;
+    instr.vectorOpcode = AluVectorOpcode::Add;
+    instr.scalarDest = 0;
+    instr.scalarWriteMask = 0b0001;
+    return instr;
+}
+}
+
+int main()
+{
+    // A constant-times-temporary scalar (mulsc1, temporary r1 = (opcode & 1)) reading r1.x while the vector writes r1.xyz.
+    AluInstruction constTimesTemp = VectorAdd(1, 0b0111);
+    constTimesTemp.scalarOpcode = AluScalarOpcode::Mulsc1;
+    constTimesTemp.src3Register = 200; // the constant
+    constTimesTemp.src3Swizzle = 0;    // temporary component x
+    Require(XenosAluCoIssueHazard(constTimesTemp), "mulsc1 reading r1.x under a vector write of r1.xyz");
+
+    AluInstruction otherComponent = constTimesTemp;
+    otherComponent.src3Swizzle = 3; // component w, which the vector does not write
+    Require(!XenosAluCoIssueHazard(otherComponent), "mulsc1 reading r1.w under a vector write of r1.xyz");
+
+    AluInstruction otherTemporary = constTimesTemp;
+    otherTemporary.scalarOpcode = AluScalarOpcode::Mulsc0; // temporary r0
+    Require(!XenosAluCoIssueHazard(otherTemporary), "mulsc0 reading r0.x under a vector write of r1.xyz");
+
+    // A two-operand scalar (muls) reading r5 in slot b only.
+    AluInstruction twoOperand = VectorAdd(5, 0b0001);
+    twoOperand.scalarOpcode = AluScalarOpcode::Muls;
+    twoOperand.src3Select = 1;
+    twoOperand.src3Register = 5;
+    twoOperand.src3Swizzle = ScalarSwizzle(2, 0); // a = z, b = x
+    Require(XenosAluCoIssueHazard(twoOperand), "muls reading r5.x in slot b under a vector write of r5.x");
+
+    AluInstruction oneOperand = twoOperand;
+    oneOperand.scalarOpcode = AluScalarOpcode::Rcp; // reads slot a (z) only
+    Require(!XenosAluCoIssueHazard(oneOperand), "rcp reading r5.z under a vector write of r5.x");
+    oneOperand.src3Swizzle = ScalarSwizzle(0, 2);
+    Require(XenosAluCoIssueHazard(oneOperand), "rcp reading r5.x under a vector write of r5.x");
+
+    AluInstruction exported = oneOperand;
+    exported.exportData = 1;
+    Require(!XenosAluCoIssueHazard(exported), "an exporting instruction");
+
+    AluInstruction relative = oneOperand;
+    relative.src3Register = 5 | 0x40;
+    Require(!XenosAluCoIssueHazard(relative), "a relative scalar source");
+
+    AluInstruction constant = oneOperand;
+    constant.src3Select = 0;
+    Require(!XenosAluCoIssueHazard(constant), "a constant scalar source");
+
+    AluInstruction retain = oneOperand;
+    retain.scalarOpcode = AluScalarOpcode::RetainPrev;
+    Require(!XenosAluCoIssueHazard(retain), "retain_prev reads no register");
+
+    AluInstruction kill = oneOperand;
+    kill.vectorOpcode = AluVectorOpcode::KillEq;
+    Require(!XenosAluCoIssueHazard(kill), "a vector kill writes no register");
+
+    AluInstruction noVectorWrite = oneOperand;
+    noVectorWrite.vectorWriteMask = 0;
+    Require(!XenosAluCoIssueHazard(noVectorWrite), "no vector write");
+
+    if (failures == 0)
+        std::cout << "alu_coissue_test: all passed\n";
+    return failures == 0 ? EXIT_SUCCESS : EXIT_FAILURE;
+}
