diff --color -ruN a/XenosRecomp/alu_coissue.h b/XenosRecomp/alu_coissue.h
--- a/XenosRecomp/alu_coissue.h	1969-12-31 19:00:00
+++ b/XenosRecomp/alu_coissue.h	2026-10-22 14:57:38
@@ -0,0 +1,70 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+#include "shader_code.h"
+
+// A Xenos ALU instruction co-issues a vector and a scalar operation. Both read their source registers before either writes
+// its result, so a scalar operation may read a temporary that the paired vector operation overwrites in the same
+// instruction and still see the previous value. The recompiler prints the vector assignment before the scalar expression;
+// when this predicate holds it prints the scalar computation (predicate, ps, a0) first instead, and the scalar register write
+// after the vector one as before.
+//
+// Scalar source operands, as the recompiler reads them: src3's swizzle slot "a" ((swizzle >> 6) + 3) for every scalar
+// operation that reads a register; slot "b" (swizzle & 3) as well for the two-operand forms; for the *sc forms the temporary
+// (opcode & 1) | (src3Select << 1) | (src3Swizzle & 0x3C), component swizzle & 3 (src3Register names the constant there).
+// Exported results, relative destinations, relative sources and vector kills (which write nothing) are not hazards here.
+inline bool XenosAluCoIssueHazard(const AluInstruction& instr)
+{
+    if (instr.exportData || instr.vectorDestRelative || instr.vectorWriteMask == 0)
+        return false;
+    if (instr.vectorOpcode >= AluVectorOpcode::KillEq && instr.vectorOpcode <= AluVectorOpcode::KillNe)
+        return false;
+
+    auto overwritten = [&](uint32_t reg, uint32_t component)
+        {
+            return reg == instr.vectorDest && ((instr.vectorWriteMask >> component) & 0x1) != 0;
+        };
+
+    switch (instr.scalarOpcode)
+    {
+    case AluScalarOpcode::SetpClr:
+    case AluScalarOpcode::RetainPrev:
+        return false;
+
+    case AluScalarOpcode::Mulsc0:
+    case AluScalarOpcode::Mulsc1:
+    case AluScalarOpcode::Addsc0:
+    case AluScalarOpcode::Addsc1:
+    case AluScalarOpcode::Subsc0:
+    case AluScalarOpcode::Subsc1:
+        return overwritten((uint32_t(instr.scalarOpcode) & 1) | (instr.src3Select << 1) | (instr.src3Swizzle & 0x3C),
+            instr.src3Swizzle & 0x3);
+
+    default:
+        break;
+    }
+
+    if (!instr.src3Select || (instr.src3Register & 0x40) != 0)
+        return false;
+
+    const uint32_t reg = instr.src3Register & 0x3F;
+    const uint32_t a = ((instr.src3Swizzle >> 6) + 3) & 0x3;
+    const uint32_t b = instr.src3Swizzle & 0x3;
+
+    switch (instr.scalarOpcode)
+    {
+    case AluScalarOpcode::Adds:
+    case AluScalarOpcode::Muls:
+    case AluScalarOpcode::Maxs:
+    case AluScalarOpcode::Mins:
+    case AluScalarOpcode::MaxAs:
+    case AluScalarOpcode::MaxAsf:
+    case AluScalarOpcode::Subs:
+        return overwritten(reg, a) || overwritten(reg, b);
+
+    default:
+        return overwritten(reg, a);
+    }
+}
